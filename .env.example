# REQUIRED

GOOGLE_API_KEY=
TAVILY_API_KEY=

# OPTIONAL — if set, the CLI always resumes this chat regardless of playlist selection
# DEFAULT_CHAT_ID=

# LLM Configuration (provider-agnostic via init_chat_model)
# Supported providers: anthropic, openai, google-genai, etc.
# Set the API key for your chosen provider (e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY)
LLM_PROVIDER=anthropic
QUERY_MODEL=claude-haiku-4-5        # Analyst, Teacher, Summarizer
GENERATION_MODEL=claude-sonnet-4-5  # Supervisor (most capable model recommended)

# Embedding Configuration (provider-agnostic via init_embeddings)
# Supported providers: voyage, openai, huggingface, etc.
# Set the API key for your chosen provider (e.g. VOYAGE_API_KEY, OPENAI_API_KEY)
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5

# API Keys (only set the ones you need based on your provider choices)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# OPTIONAL

PROXY_USER=
PROXY_PASS=

# PERSIST_DIR=./db
# LANG=en

# SEARCH_TYPE=similarity
# SEARCH_K=2
# ENABLE_HYBRID_SEARCH=true

# MMR_DIVERSITY_LAMBDA=0.7
# MMR_FETCH_K=20

# DISPLAY_OBSERVATIONS=false
# TRANSCRIPT_OVERLAP_CHARS=100
